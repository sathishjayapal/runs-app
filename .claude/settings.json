{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "bash ./scripts/verify.sh --quick",
            "timeout": 120,
            "statusMessage": "Running golden copy verification..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/rabbitmq-payload-reminder.sh",
            "timeout": 10,
            "statusMessage": "Checking RabbitMQ payload rule..."
          }
        ]
      }
    ]
  }
}
