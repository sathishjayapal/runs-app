# Runs App Environment Configuration
# Copy this file to .env and update with your actual values
# DO NOT COMMIT .env to git - it contains secrets

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5443/runsapp_db
JDBC_DATABASE_USERNAME=runsapp_local
JDBC_DATABASE_PASSWORD=your-secure-password-here

# ============================================================
# RABBITMQ CONFIGURATION
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbit_local
RABBITMQ_PASSWORD=your-secure-password-here

# ============================================================
# SERVER CONFIGURATION
# ============================================================
SERVER_PORT=8080
BASE_HOST=http://localhost:8080

# CORS configuration - comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# SAMPLE DATA INITIALIZATION (Dev Only)
# ============================================================
# IMPORTANT: Set to 'false' for production environments
# Set to 'true' only when running locally with dev profile
APP_INITIALIZATION_ENABLE_SAMPLE_DATA=false

# Sample admin user credentials (only used if enable-sample-data=true)
# These should NEVER be set in production
APP_INITIALIZATION_ADMIN_EMAIL=admin@runsapp.com
APP_INITIALIZATION_ADMIN_PASSWORD=admin123

# Sample regular user credentials (only used if enable-sample-data=true)
APP_INITIALIZATION_USER_EMAIL=runner@runsapp.com
APP_INITIALIZATION_USER_PASSWORD=runner123

# Sample system user credentials for automated imports (only used if enable-sample-data=true)
APP_INITIALIZATION_SYSTEM_EMAIL=system@runsapp.com
APP_INITIALIZATION_SYSTEM_PASSWORD=system123

# ============================================================
# SMTP CONFIGURATION (Optional - for email features)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email Display Settings
MAIL_FROM=noreply@runsapp.com
MAIL_DISPLAY_NAME=Runs App

# ============================================================
# GARMIN IMPORT CONFIGURATION
# ============================================================
GARMIN_CSV_IMPORT_ENABLED=true
GARMIN_SYSTEM_USER_ID=system-user-id-from-database
GARMIN_CSV_IMPORT_SCHEDULE=0 0 2 * * ?
GARMIN_IMPORT_SOURCE=DRIVE

# Google Drive Folder IDs (if using DRIVE source)
GARMIN_DRIVE_FOLDER_ID=your-folder-id
GARMIN_DRIVE_PROCESSED_FOLDER_ID=your-processed-folder-id
GARMIN_DRIVE_QUARANTINE_FOLDER_ID=your-quarantine-folder-id
GARMIN_DRIVE_FAILED_FOLDER_ID=your-failed-folder-id
GARMIN_DRIVE_RETRY_FOLDER_ID=your-retry-folder-id

# Google Drive Service Account (choose one, not both)
# Option 1: Path to service account JSON file
GARMIN_DRIVE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
# Option 2: Base64 encoded service account JSON (for docker/k8s)
# GARMIN_DRIVE_SERVICE_ACCOUNT_KEY_BASE64=your-base64-encoded-key

GARMIN_DRIVE_APPLICATION_NAME=Runs App CSV Importer

# Garmin CSV Import Alert Configuration
GARMIN_ALERT_EMAIL_ENABLED=true
GARMIN_ALERT_EMAIL_MAX_RETRY_ATTEMPTS=3
GARMIN_ALERT_EMAIL_RECIPIENTS=admin@example.com
GARMIN_ALERT_EMAIL_FROM=garmin-import@example.com

# ============================================================
# RUNS AI ANALYZER INTEGRATION
# ============================================================
RUNS_AI_ANALYZER_URL=http://localhost:8081

# ============================================================
# SPRING PROFILES (For local development)
# ============================================================
# Uncomment to use specific profile(s): dev, prod, or leave empty for default
SPRING_PROFILES_ACTIVE=dev



